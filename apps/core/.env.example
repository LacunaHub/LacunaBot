# Only for local development
NODE_ENV=development

LCN_DB_URI=mongodb://127.0.0.1:27017/
LCN_REDIS_URI=redis://user:pass@127.0.0.1:6379/
LCN_ROOT_DOMAIN=localhost
LCN_API_PORT=5810
LCN_API_URL=http://localhost:5810
LCN_WEBSITE_URL=http://localhost:5820

LCN_DISCORD_CLIENT_ID=
LCN_DISCORD_CLIENT_SECRET=
LCN_DISCORD_CLIENT_TOKEN=

# host;username;password
# or just specify host if you didn't configure basic auth
GRAFANA_LOKI=

LCN_GOOGLE_API_KEY=
LCN_GEMINI_API_KEY=

# Public telegram bot token for social alerts
LCN_TELEGRAM_PUBLIC_BOT_TOKEN=
# TelegramBot signature verification
LCN_TELEGRAM_PUBLIC_BOT_HMAC_SECRET=signature_secret

LCN_TWITCH_CLIENT_ID=
LCN_TWITCH_CLIENT_SECRET=
# Twitch signature verification
LCN_TWITCH_SIGNING_SECRET=signature_secret
# PubSubhubbub signature verification
LCN_YOUTUBE_HMAC_SECRET=signature_secret

# name:ip:port:password
LCN_LAVALINK_NODES=

LCN_SUPPORT_SERVER_ID=
LCN_PROJECT_TEAM_ROLE_ID=
