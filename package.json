{
  "name": "lacuna-bot",
  "version": "4.12.3",
  "description": "Feature-rich Discord bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ./clean.dist.js && tsc --build tsconfig.json",
    "start": "node -r ./config.env.js .",
    "start:api": "wait-on tcp:5565 && node -r ./config.env.js ./dist/api",
    "start:bot": "node -r ./config.env.js ./dist/internals",
    "dev": "npm run build && concurrently \"npm:start\" \"npm:start:api\" \"npm:start:bot\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LacunaHub/Discord.git"
  },
  "author": "Lacuna (https://github.com/LacunaHub)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LacunaHub/Discord/issues"
  },
  "homepage": "https://github.com/LacunaHub/Discord#readme",
  "dependencies": {
    "@google/generative-ai": "^0.17.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.1",
    "@lacunahub/lacuna-database-driver": "^1.1.5",
    "@lacunahub/lacuna-locale": "^1.0.7",
    "@lacunahub/lavaluna.js": "^1.0.2",
    "@lacunahub/letsfrag": "^1.0.0",
    "@lacunahub/logger": "^1.0.3",
    "bufferutil": "^4.0.1",
    "canvas": "^2.11.2",
    "discord.js": "^14.16.2",
    "dotenv": "^16.4.5",
    "isolated-vm": "^5.0.1",
    "koa": "^2.15.3",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.2.1",
    "koa-ratelimit": "^5.1.0",
    "moment": "^2.30.1",
    "mongoose": "^5.13.22",
    "ms": "^2.1.3",
    "node-fetch": "^2.7.0",
    "node-os-utils": "^1.3.7",
    "node-schedule": "^2.1.1",
    "numbro": "^2.5.0",
    "prom-client": "^15.1.3",
    "quickmongo": "^5.2.0",
    "raw-body": "^3.0.0",
    "safe-regex": "^2.1.1",
    "tslib": "^2.7.0",
    "unicode-default-word-boundary": "^16.0.0",
    "unzalgo": "^3.0.0",
    "utf-8-validate": "^6.0.3",
    "xml2js": "^0.6.2",
    "zlib-sync": "^0.1.9"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-json": "^2.0.23",
    "@types/koa-logger": "^3.1.5",
    "@types/koa-ratelimit": "^5.0.5",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.16.5",
    "@types/node-fetch": "^2.6.11",
    "@types/node-os-utils": "^1.3.4",
    "@types/node-schedule": "^2.1.7",
    "@types/safe-regex": "^1.1.6",
    "@types/unzalgo": "^3.0.2",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^8.2.2",
